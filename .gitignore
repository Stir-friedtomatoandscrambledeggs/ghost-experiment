# ============ Ghost 运行时（本机安装/生成产物，整体不入库） ============
# 主题源码在 theme/，内容种子在 scripts/seed；runtime 由 ghost install local 重建
runtime/

# ============ 数据库与日志（双保险） ============
*.sqlite3
*.sqlite3-*
*.log
*.pid
.ghostpid

# ============ Node ============
node_modules/
theme/**/node_modules/
# 主题 assets/built 为可直接安装所需的预编译产物，予以保留入库

# ============ 密钥/环境变量 ============
.env
.env.local
*.pem
*.key

# ============ 系统/编辑器 ============
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============ 演示导出（脱敏文件统一放 exports/，按需单独提交） ============
exports/*.json
!exports/.gitkeep
