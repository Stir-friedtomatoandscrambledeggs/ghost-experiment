# ============================================================
# 环境变量示例（复制为 .env 后按需填写；.env 不入库）
# Ghost 本地实例默认通过 config.development.json / 环境变量读取配置
# ============================================================

# 站点对外地址（本地固定为 2368）
NODE_ENV=development
url=http://localhost:2368/

# ---- 本地离线邮件（会员魔法链接 / 评论通知）----
# 实验使用本机 SMTP 捕获服务（见 README「邮件与演示账号」），不连真实邮件服务商
mail__transport=SMTP
mail__options__host=127.0.0.1
mail__options__port=1025
mail__from=Ghost实验 <no-reply@example.com>

# ---- 镜像（仅安装/复现时使用，不参与运行）----
# npm/corepack: https://registry.npmmirror.com
# node 头文件 : https://registry.npmmirror.com/-/binary/node
